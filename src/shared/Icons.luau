-- Icon registry. Keys map to uploaded image assets (IconIds, generated by tools/upload_icons.py).
-- Any key without an asset id falls back to an emoji, so the UI always shows something.
local Icons = {}

local ok, ids = pcall(require, script.Parent.IconIds)
ids = ok and typeof(ids) == "table" and ids or {}

Icons.Emoji = {
	Coin = "🪙", Star = "⭐", Clover = "🍀", Arm = "💪", Shop = "🛒", Paw = "🐾", Backpack = "🎒",
	Planet = "🗺️", Upgrade = "⚡", Book = "📖", Settings = "⚙️", Close = "✕", Lock = "🔒", Pin = "📍",
	Info = "ℹ️", Crown = "👑", Gift = "🎁", Chest = "🧰", Heart = "❤️", Trash = "🗑️",
}

function Icons.image(key)
	local id = key and ids[key]
	return id and ("rbxassetid://" .. id) or nil
end

function Icons.emoji(key)
	return key and Icons.Emoji[key] or nil
end

return Icons
