{
  "name": "ThrowFoodForAnimals",
  "emitLegacyScripts": false,
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$path": "src/shared"
      },
      "Client": {
        "$path": "src/client"
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Main": {
        "$path": "src/server/Main.server.luau"
      },
      "Services": {
        "$path": "src/server/Services"
      }
    },
    "ServerStorage": {
      "$className": "ServerStorage",
      "AdminClient": {
        "$path": "src/serverstorage/AdminClient.client.luau"
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "StreamingEnabled": true
      }
    }
  }
}